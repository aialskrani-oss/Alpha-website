# ─────────────────────────────────────────────
#  Alpha Platform — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# PostgreSQL connection string (required)
# For Vercel: use Neon (https://neon.tech) or Supabase (https://supabase.com)
DATABASE_URL=postgresql://user:password@host:5432/alpha_platform

# Session secret for cookie signing
SESSION_SECRET=change_me_to_a_random_32_char_string
